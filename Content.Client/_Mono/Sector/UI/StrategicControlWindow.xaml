<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc strategic-control-title}"
                      MinSize="360 480"
                      SetSize="360 480">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="4">
        <Label Name="NameLabel" StyleClasses="LabelHeading"/>
        <Label Name="OwnerLabel"/>
        <Label Name="ProgressLabel"/>
        <Label Name="CoordsLabel"/>
        <Label Name="PoolsLabel" Margin="0 8 0 0"/>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0 8 0 0">
            <Button Name="ClaimButton" Text="{Loc strategic-control-claim}" HorizontalExpand="True"/>
            <Button Name="RelinquishButton" Text="{Loc strategic-control-relinquish}" HorizontalExpand="True"/>
        </BoxContainer>

        <Label Text="{Loc strategic-control-trade}" StyleClasses="LabelHeading" Margin="0 12 0 0"/>
        <CheckBox Name="BuyCheck" Text="{Loc strategic-control-buy-enabled}"/>
        <CheckBox Name="SellCheck" Text="{Loc strategic-control-sell-enabled}"/>

        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc strategic-control-price-fuel}" MinWidth="140"/>
            <LineEdit Name="FuelPriceEdit" HorizontalExpand="True"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc strategic-control-price-munitions}" MinWidth="140"/>
            <LineEdit Name="MunitionsPriceEdit" HorizontalExpand="True"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc strategic-control-price-parts}" MinWidth="140"/>
            <LineEdit Name="PartsPriceEdit" HorizontalExpand="True"/>
        </BoxContainer>

        <Button Name="ApplyTradeButton" Text="{Loc strategic-control-apply-trade}" Margin="0 6 0 0"/>
    </BoxContainer>
</controls:FancyWindow>
