<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc strategic-control-title}"
                      MinSize="550 480"
                      SetSize="550 480">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="4">
        <Label Name="NameLabel" StyleClasses="LabelHeading"/>
        <Label Name="OwnerLabel"/>
        <Label Name="ProgressLabel"/>
        <Label Name="CoordsLabel"/>
        <Label Name="PoolsLabel" Margin="0 8 0 0"/>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0 8 0 0">
            <Button Name="ClaimButton" Text="{Loc strategic-control-claim}" HorizontalExpand="True"/>
            <Button Name="RelinquishButton" Text="{Loc strategic-control-relinquish}" HorizontalExpand="True"/>
        </BoxContainer>

        <Label Text="{Loc strategic-control-trade}" StyleClasses="LabelHeading" Margin="0 12 0 0"/>
        <CheckBox Name="BuyCheck" Text="{Loc strategic-control-buy-enabled}"/>
        <CheckBox Name="SellCheck" Text="{Loc strategic-control-sell-enabled}"/>

        <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True">
            <Label Text="{Loc strategic-resource-fuel}" MinWidth="80"/>
            <LineEdit Name="FuelPriceLabel" MinSize="70 0"/>
            <Slider Name="FuelPriceSlider" HorizontalExpand="True" MinValue="0" MaxValue="5000"/>
            <BoxContainer Orientation="Horizontal">
                <Button Name="FuelPriceDecrease" Text="-100"/>
                <Button Name="FuelPriceIncrease" Text="+100"/>
            </BoxContainer>
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True">
            <Label Text="{Loc strategic-resource-munitions}" MinWidth="80"/>
            <LineEdit Name="AmmoPriceLabel" MinSize="70 0"/>
            <Slider Name="AmmoPriceSlider" HorizontalExpand="True" MinValue="0" MaxValue="5000"/>
            <BoxContainer Orientation="Horizontal">
                <Button Name="AmmoPriceDecrease" Text="-100"/>
                <Button Name="AmmoPriceIncrease" Text="+100"/>
            </BoxContainer>
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True">
            <Label Text="{Loc strategic-resource-parts}" MinWidth="80"/>
            <LineEdit Name="PartPriceLabel" MinSize="70 0"/>
            <Slider Name="PartPriceSlider" HorizontalExpand="True" MinValue="0" MaxValue="5000"/>
            <BoxContainer Orientation="Horizontal">
                <Button Name="PartPriceDecrease" Text="-100"/>
                <Button Name="PartPriceIncrease" Text="+100"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
